#!/bin/bash
set -euo pipefail
umask 077
dnf install -y docker curl
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins /opt/wikijs/monitoring/grafana
curl -fsSL --retry 5 https://github.com/docker/compose/releases/download/v2.32.4/docker-compose-linux-x86_64 -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod 755 /usr/local/lib/docker/cli-plugins/docker-compose
cd /opt/wikijs
printf '%s' '${compose_b64}' | base64 -d > compose.yml
printf '%s' '${prometheus_b64}' | base64 -d > monitoring/prometheus.yml
printf '%s' '${datasource_b64}' | base64 -d > monitoring/grafana/datasource.yml
printf '%s' '${dashboards_b64}' | base64 -d > monitoring/grafana/dashboards.yml
printf '%s' '${dashboard_b64}' | base64 -d > monitoring/grafana/dashboard.json
curl -fsSL --retry 5 https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem -o rds.pem
chmod 644 rds.pem monitoring/prometheus.yml monitoring/grafana/*.yml monitoring/grafana/*.json
chmod 755 monitoring monitoring/grafana
docker compose up -d
